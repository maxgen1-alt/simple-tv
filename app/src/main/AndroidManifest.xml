<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the settings screen install updates (Android still asks you to confirm each one) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets later updates install without a confirm box (Android 12+, once it installed itself) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- TV app: no touchscreen needed, works on Google TV / Android TV -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets us see and open the other apps (required on Android 11+) -->
    <queries>
        <package android:name="com.google.android.youtube.tvunplugged" />
        <package android:name="com.etvnet.androidtv.tvstore" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.cbs.app" />
        <package android:name="com.dazn" />
        <package android:name="com.espn.gtv" />
        <package android:name="com.espn.score_center" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Home screens: so Settings can check another one exists before turning ours off -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">

            <!-- Shows up in the app list -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Makes this THE home screen (what the Home button opens).
            OFF by default, so installing on your own Chromecast never touches your home screen.
            Turn on for their stick only, from the app: settings (Up x5, Left x5) → "Make Simple TV the home screen"
            (Android 14 refuses "adb shell pm enable" for this). Only then switch Google TV's off.
        -->
        <activity-alias
            android:name=".HomeScreen"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PhotosActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Gets the result from Android's installer after an update -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Right after an update installs: back to the home screen (not the last app) -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Clicks through eTVnet to RTVI / NTV. Off until switched on in Settings > Accessibility. -->
        <service
            android:name=".AutoTuneService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autotune" />
        </service>
    </application>
</manifest>
